# --- Root ignores for SmartDine (Python backend + Node frontend)

# OS / Editors
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Env & secrets
.env
.env.*
*.env

# Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
.mypy_cache/
.pytest_cache/
.coverage*
htmlcov/
.tox/
venv/
ENV/
.env.local

# Backend build & logs
backend/.pytest_cache/
backend/__pycache__/
backend/instance/
backend/*.log
backend/*.sqlite3
backend/.coverage*
backend/venv/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/.parcel-cache/
frontend/.next/
frontend/.nuxt/
frontend/.svelte-kit/
frontend/dist/
frontend/build/
frontend/.turbo/
frontend/.vercel/

# Frontend build artifacts
*.map
*.cache/
*.lock-wscript
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Misc
*.log
*.tmp
*.bak
*.orig

# Python bytecode anywhere
**/__pycache__/
**/*.py[cod]
